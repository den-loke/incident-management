{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incident-management",
  "account_id": "8cb3be55b69e0f8e39872d083ce7b04e",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Scheduled work (see src/oncall/cron.ts). Daily shift-generation tops up the
  // rotation ~4 weeks ahead. The ~1-min escalation sweep is added in on-call slice 3.
  // NOTE: named envs do NOT inherit top-level triggers — repeated in each below.
  "triggers": { "crons": ["0 0 * * *", "* * * * *"] },

  // Per-incident state + timers. One Durable Object instance == one incident.
  "durable_objects": {
    "bindings": [
      { "name": "INCIDENT", "class_name": "Incident" },
      { "name": "INCIDENT_COUNTER", "class_name": "IncidentCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Incident"] },
    { "tag": "v2", "new_sqlite_classes": ["IncidentCounter"] }
  ],

  // Incident data / audit log / internal status page (source of truth).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incident-management",
      "database_id": "PLACEHOLDER_CREATE_WITH_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ],

  // React SPA (built from web/ into ./public). Served via the ASSETS binding;
  // unknown paths fall back to index.html for client-side routing. The Worker
  // still owns /api/*, /auth/*, /slack/events, /health before assets are tried.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // --- Two named environments = two URLs, one Slack workspace each. ---
  // Each gets its own worker name (=> its own <name>.<subdomain>.workers.dev URL)
  // and its own D1 database. Deploy with:  wrangler deploy --env test | production
  // Set per-env secrets with:  wrangler secret put <NAME> --env test|production
  // (SLACK_TEAM_ID, SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, SLACK_CLIENT_ID,
  //  SLACK_CLIENT_SECRET, OPENAI_API_KEY, and optionally STATUSPAGE_*/RECALLAI_API_KEY.)
  // The OIDC redirect_uri is derived from the request origin, so each URL just
  // needs its own https://<url>/auth/callback registered on its Slack app.
  "env": {
    "test": {
      "name": "incident-management-test",
      "triggers": { "crons": ["0 0 * * *", "* * * * *"] },
      "vars": {
        "APP_BASE_URL": "https://incident-management-test.lokeglobal.workers.dev",
        "SLACK_CLIENT_ID": "11966909474212.11974798087254",
        "SLACK_TEAM_ID": "T0BUESRDY68",
        "OPENAI_MODEL": "gpt-5.6-terra",
        "ONCALL_TZ": "Australia/Melbourne",
        "ONCALL_ROTATION_DAYS": "7",
        "ONCALL_ACK_TIMEOUT_MIN": "10",
        "TEAM_ENGINEERING_USERGROUP": "S0BUWT6C8G2",
        "TEAM_SUPPORT_USERGROUP": "S0BUYREJH41",
        "TEAM_STAKEHOLDERS_USERGROUP": "S0BUSJBFLE9"
      },
      "durable_objects": {
        "bindings": [
          { "name": "INCIDENT", "class_name": "Incident" },
          { "name": "INCIDENT_COUNTER", "class_name": "IncidentCounter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Incident"] },
        { "tag": "v2", "new_sqlite_classes": ["IncidentCounter"] }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "incident-management-test",
          "database_id": "04810e8d-fdf1-45e7-98b3-49ef51400c2b",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "incident-management",
      "triggers": { "crons": ["0 0 * * *", "* * * * *"] },
      "vars": {
        "APP_BASE_URL": "https://incident-management.lokeglobal.workers.dev",
        "OPENAI_MODEL": "gpt-5.6-terra",
        "ONCALL_TZ": "Australia/Melbourne",
        "ONCALL_ROTATION_DAYS": "7",
        "ONCALL_ACK_TIMEOUT_MIN": "10"
      },
      "durable_objects": {
        "bindings": [
          { "name": "INCIDENT", "class_name": "Incident" },
          { "name": "INCIDENT_COUNTER", "class_name": "IncidentCounter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Incident"] },
        { "tag": "v2", "new_sqlite_classes": ["IncidentCounter"] }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "incident-management-prod",
          "database_id": "PLACEHOLDER_CREATE_WITH_wrangler_d1_create",
          "migrations_dir": "migrations"
        }
      ]
    }
  }

  // Workflows (retry-heavy flows: Recall 507 retries, Statuspage 429 backoff).
  // Enable once the first Workflow class exists:
  // "workflows": [
  //   { "name": "incident-flows", "binding": "INCIDENT_FLOWS", "class_name": "IncidentFlow" }
  // ]
}
